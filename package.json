{
  "name": "free-domain-browser",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform Tauri browser with free-domain registry resolution",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "dev:verbose": "node scripts/tauri.mjs dev -v",
    "build": "node scripts/tauri.mjs build",
    "doctor": "node scripts/doctor.mjs",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "icon": "tauri icon assets/icon.svg --ios-color \"#080d24\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "license": "GPL-3.0-only",
  "author": "Free Domain Name contributors",
  "homepage": "https://free-domain-name.github.io/tauri-browser/"
}
